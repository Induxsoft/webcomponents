    "luz": [
     "<body style=\"font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;\" {foco}>",
     " \"\\n    \"",
     " <div style=\"max-width: 100vw; padding: 8px 16px; border: 1px solid #DDD;border-radius: 5px; padding-bottom: 32px; margin:4px;\">",
     "  \"\\n        \\n        \"",
     "  <div style=\"display: flex; gap: 8px; padding: 1rem 0; align-items: center;\">",
     "   \"\\n            \"",
     "   <h3 style=\"margin: 0;\">",
     "    \"Edit Table\"",
     "   </h3>",
     "   \"\\n            \"",
     "   <button onclick=\"document.querySelector('#tabla-demo').AddRow();\" style=\"color: #888;\">",
     "    \"+\"",
     "   </button>",
     "   \"\\n            \"",
     "   <button onclick=\"copyData()\" style=\"color: #000;\">",
     "    \"Copiar datos\"",
     "   </button>",
     "   \"\\n        \"",
     "  </div>",
     "  \"\\n\\n        \"",
     "  <div style=\"max-height: 50vh; display: flex;\">",
     "   \"\\n            \"",
     "   <edit-table control-styles=\"tr td{height: 2rem !important;}\" id=\"tabla-demo\" style=\"width: 100%;\" data=\"[{\\\"solo_adultos\\\":\\\"No\\\",\\\"titulo\\\":\\\"El hombre araña\\\",\\\"director\\\":\\\"Sam Raimi\\\",\\\"id_genero\\\":\\\"01\\\",\\\"genero\\\":\\\"Acción\\\",\\\"sinopsis\\\":\\\"\\\",\\\"estreno\\\":\\\"2006-09-03\\\",\\\"tipo\\\":\\\"Live Action\\\"}]\">",
     "    #shadow-root -> tablas[0]",
     "   </edit-table>",
     "   \"\\n        \"",
     "  </div>",
     "  \"\\n    \"",
     " </div>",
     " \"\\n\\n\\n    \"",
     " <script>",
     "  \"\\n        function copyData()\\n        {\\n            navigator.clipboard.writeText(JSON.stringify(document.querySelector('#tabla-demo').DataArray)).then(()=>{\\n                console.log('¡Datos copiados al portapapeles!');\\n            }, ()=> {\\n                console.log('¡Ocurrió un error al copiar los datos!');\\n            });\\n        }\\n        document.addEventListener('DOMContentLoaded', () => \\n        {\\n            var table = document.querySelector('#tabla-demo');\\n\\n            table.Events[table.EdiTable.Const.Events.EnterCell]=function(e)\\n            {\\n                console.log(\\\"Tabla:\\\"+e.sender.tableId);\\n                console.log(\\\"Fila:\\\"+e.sender.CurrentRowIndex().toString()+\\\", Columna:\\\"+e.sender.CurrentColIndex().toString());\\n            };\\n\\n            //Ejemplo de implementación de la edición usando una columna personalizada\\n            table.Events[table.EdiTable.Const.Events.StartEdition]=function(e)\\n            {\\n                if (e.coldef.field==\\\"estrellas\\\")\\n                {\\n                    let obj=e.sender.DataArray[e.sender.RowIndexOfTd(e.td)];\\n\\n                    let contador=parseInt(obj[e.coldef.field]);\\n\\n                    if (isNaN(contador))\\n                        contador=0;\\n\\n                    contador++;\\n                    obj[e.coldef.field]=contador;\\n\\n                    //  Para actualizar la tabla, se puede optar por:\\n                    //  1-Actualizar el objeto subyacente y luego toda la fila:\\n                    //  La ventaja de actualizar toda la fila es que se pueden actualizar valores a otras columnas\\n                    if (contador==4)\\n                        obj[\\\"director\\\"]=\\\"CUATRO\\\";\\n\\n                    e.sender.UpdateRow(e.sender.RowIndexOfTd(e.td));\\n\\n                    //  2-O confirmar la edición de la celda:\\n                    // e.sender.ConfirmEdit(e.td,contador.toString());\\n\\n                    e.sender.CellFocus(e.td); //Esta línea vuelve a seleccionar la celda editada\\n                }\\n            }\\n\\n            //Ejemplo de validación de entrada y almacenamiento de la clave de una opción de Select en un miembro\\n            table.Events[table.EdiTable.Const.Events.BeforeUpdateCell]=function(e)\\n            {\\n                if (e.text==\\\"juan\\\" && e.coldef.field==\\\"titulo\\\")\\n                {\\n                    alert(\\\"NO debes escribir juan en la columna 'Título'\\\");\\n                    e.cancel=true;\\n                }\\n                if (e.coldef.field==\\\"genero\\\")\\n                {\\n                    var combo=e.input;\\n                    if (combo.selectedIndex<0)\\n                        e.text=\\\"\\\";\\n                    else\\n                        e.text=combo.options[combo.selectedIndex].text;\\n                        \\n                    e.sender.UpdateDataMember (e.sender.RowIndexOfTd(e.td),\\\"id_genero\\\",e.input.value);\\n                }\\n            };\\n            //Usa la clave almacenada para establecer el valor del Select\\n            table.Events[table.EdiTable.Const.Events.BeforeSetInput]=function(e){\\n                if (e.coldef.field==\\\"genero\\\")\\n                {\\n                    e.text=e.sender.DataArray[e.sender.RowIndexOfTd(e.td)].id_genero;\\n                }\\n            };\\n        });\\n    \"",
     " </script>",
     " \"\\n\\n\"",
     "</body>"
    ],
