     "<body {foco}>",
     " \"\\n\"",
     " <div id=\"work_area\" class=\"mt-1 p-2 pt-0\">",
     "  <div style=\"height:100%;\">",
     "   <div style=\"overflow-y:auto; max-height:75vh;\" id=\"list_table_container\">",
     "    <edit-table id=\"table_3f9c2a1\" data=\"[{\\\"sys_pk\\\":1000,\\\"sys_dtcreated\\\":\\\"2026-01-01 10:00:00\\\",\\\"sys_info\\\":\\\"\\\",\\\"codigo\\\":\\\"PRB-000\\\",\\\"nombre\\\":\\\"Registro de prueba 0\\\",\\\"importe\\\":0},{\\\"sys_pk\\\":1001,\\\"sys_dtcreated\\\":\\\"2026-02-02 10:00:00\\\",\\\"sys_info\\\":\\\"\\\",\\\"codigo\\\":\\\"PRB-037\\\",\\\"nombre\\\":\\\"Registro de prueba 1\\\",\\\"importe\\\":135.8},{\\\"sys_pk\\\":1002,\\\"sys_dtcreated\\\":\\\"2026-03-03 10:00:00\\\",\\\"sys_info\\\":\\\"\\\",\\\"codigo\\\":\\\"PRB-074\\\",\\\"nombre\\\":\\\"Registro de prueba 2\\\",\\\"importe\\\":271.7}]\" hidde-selector=\"true\" cards-responsive=\"true\" style=\"width:100%;\" control-styles=\"                        div:has(table#table_3f9c2a1) { overflow:revert !important; }\\n                        #table_3f9c2a1 tr th { font-weight:500; }\\n                    \\n                        @media print {\\n                            #table_3f9c2a1 { overflow:hidden; }\\n                        }\\n\\n                        \">",
