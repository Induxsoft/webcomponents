     "    \"Mostrando los primeros 3 registros ordenados por código\"",
     "   </small>",
     "   <script type=\"text/javascript\" id=\"uie.dbeditable-script\">",
     "    \"                document.addEventListener(\\\"DOMContentLoaded\\\", () => {\\n                    const table = document.getElementById(\\\"table_3f9c2a1\\\");\\n                    const data = [{\\\"sys_pk\\\":1000,\\\"sys_dtcreated\\\":\\\"2026-01-01 10:00:00\\\",\\\"sys_info\\\":\\\"\\\",\\\"codigo\\\":\\\"PRB-000\\\",\\\"nombre\\\":\\\"Registro de prueba 0\\\",\\\"importe\\\":0},{\\\"sys_pk\\\":1001,\\\"sys_dtcreated\\\":\\\"2026-02-02 10:00:00\\\",\\\"sys_info\\\":\\\"\\\",\\\"codigo\\\":\\\"PRB-037\\\",\\\"nombre\\\":\\\"Registro de prueba 1\\\",\\\"importe\\\":135.8},{\\\"sys_pk\\\":1002,\\\"sys_dtcreated\\\":\\\"2026-03-03 10:00:00\\\",\\\"sys_info\\\":\\\"\\\",\\\"codigo\\\":\\\"PRB-074\\\",\\\"nombre\\\":\\\"Registro de prueba 2\\\",\\\"importe\\\":271.7}];\\n                    const pages = {};\\n                    \\n                    if (table)\\n                    {\\n                        table.AutoAddRow = false;\\n                        table.AutoDelRow = false;\\n                        table.EverMove = false;\\n                        \\n                        // Vista con filas anidadas\\n                        if (false)\\n                        {\\n                            table.removeAttribute(\\\"data\\\");\\n                            table.DataArray = data;\\n                            table._expandOnStart = false;\\n                            table._printTreeData();\\n                        }\\n                        // Paginación\\n                        if (false)\\n                        {\\n                            let perPage = 250\\n                            let numItems = data.length\\n                            let numPages = Math.ceil(numItems / perPage)\\n                            let currentPage = 1\\n\\n                            for (let i = 0; i < numItems; i += perPage) {\\n                                pages[Object.keys(pages).length + 1] = data.slice(i, i + perPage)\\n                            }\\n\\n                            const renderPagination = () =>\\n                            {\\n                                const container = document.getElementById(\\\"table_3f9c2a1_pagination\\\")\\n\\n                                if (!container || numPages <= 1) return\\n\\n                                let html = \\\"\\\"\\n\\n                                html += `\\n                                    <button type=\\\"button\\\"\\n                                        class=\\\"btn btn-sm btn-outline-secondary\\\"\\n                                        ${currentPage === 1 ? \\\"disabled\\\" : \\\"\\\"}\\n                                        onclick=\\\"pagination.goto(${currentPage - 1})\\\">\\n                                        &lt;\\n                                    </button>\\n                                `\\n\\n                                if (numPages <= 5)\\n                                {\\n                                    for (let page = 1; page <= numPages; page++)\\n                                    {\\n                                        html += `\\n                                            <button type=\\\"button\\\"\\n                                                class=\\\"btn btn-sm ${page === currentPage ? \\\"btn-secondary\\\" : \\\"btn-outline-secondary\\\"}\\\"\\n                                                onclick=\\\"pagination.goto(${page})\\\">\\n                                                ${page}\\n                                            </button>\\n                                        `\\n                                    }\\n                                }\\n                                else\\n                                {\\n                                    html += `\\n                                        <button type=\\\"button\\\"\\n                                            class=\\\"btn btn-sm ${currentPage === 1 ? \\\"btn-secondary\\\" : \\\"btn-outline-secondary\\\"}\\\"\\n                                            onclick=\\\"pagination.goto(1)\\\">\\n                                            1\\n                                        </button>\\n                                    `\\n\\n                                    if (currentPage > 3)\\n                                        html += `<span class=\\\"px-1\\\">...</span>`\\n\\n                                    let start = Math.max(2, currentPage - 1)\\n                                    let end = Math.min(numPages - 1, currentPage + 1)\\n\\n                                    if (currentPage <= 3)\\n                                    {\\n                                        start = 2\\n                                        end = 3\\n                                    }\\n\\n                                    if (currentPage >= numPages - 2)\\n                                    {\\n                                        start = numPages - 2\\n                                        end = numPages - 1\\n                                    }\\n\\n                                    for (let page = start; page <= end; page++)\\n                                    {\\n                                        html += `\\n                                            <button type=\\\"button\\\"\\n                                                class=\\\"btn btn-sm ${page === currentPage ? \\\"btn-secondary\\\" : \\\"btn-outline-secondary\\\"}\\\"\\n                                                onclick=\\\"pagination.goto(${page})\\\">\\n                                                ${page}\\n                                            </button>\\n                                        `\\n                                    }\\n\\n                                    if (currentPage < numPages - 2)\\n                                        html += `<span class=\\\"px-1\\\">...</span>`\\n\\n                                    html += `\\n                                        <button type=\\\"button\\\"\\n                                            class=\\\"btn btn-sm ${currentPage === numPages ? \\\"btn-secondary\\\" : \\\"btn-outline-secondary\\\"}\\\"\\n                                            onclick=\\\"pagination.goto(${numPages})\\\">\\n                                            Último\\n                                        </button>\\n                                    `\\n                                }\\n\\n                                html += `\\n                                    <button type=\\\"button\\\"\\n                                        class=\\\"btn btn-sm btn-outline-secondary\\\"\\n                                        ${currentPage === numPages ? \\\"disabled\\\" : \\\"\\\"}\\n                                        onclick=\\\"pagination.goto(${currentPage + 1})\\\">\\n                                        &gt;\\n                                    </button>\\n                                `\\n\\n                                container.innerHTML = html\\n                            }\\n\\n                            window.pagination = {\\n                                goto: (numPage) =>\\n                                {\\n                                    if (numPage < 1 || numPage > numPages) return\\n                                    \\n                                    const leyend = document.getElementById(\\\"table_3f9c2a1_leyend\\\")\\n                                    currentPage = numPage\\n\\n                                    table.DataArray = pages[numPage] ?? []\\n                                    if (leyend)\\n                                    {\\n                                        let start = (numPage - 1) * perPage\\n                                        let end = start + table.DataArray.length\\n                                        let text = \\\"Mostrando registros: \\\" + start +\\\" a \\\"+ end +\\\" de \\\"+ numItems\\n                                        leyend.textContent = text\\n                                    }\\n                                    table._printRows()\\n\\n                                    renderPagination()\\n                                }\\n                            }\\n\\n                            table.removeAttribute(\\\"data\\\")\\n                            pagination.goto(1)\\n                        }\\n\\n                        table.Events[table.EdiTable.Const.Events.OnSort] = (e) =>\\n                        {\\n                            const table_leyend = document.getElementById(\\\"table_3f9c2a1_leyend\\\");\\n                            let length = (table?.DataArray ?? []).length;\\n                            let leyend = \\\"No se encontraron resultados.\\\";\\n\\n                            if (length > 0) leyend = \\\"Mostrando los primeros \\\"+length+\\\" registros\\\";\\n                            if (e && length > 0) leyend += \\\" ordenados por \\\"+e.caption+\\\" \\\"+e.coldef.sort;\\n\\n                            table_leyend.textContent = leyend;\\n                        }\\n                    }\\n                });\"",
     "   </script>",
